# Base variables
PROJECT_NAME=dookug
# Liquibase image
LIQUIBASE_IMAGE=liquibase/liquibase:4.33
# Postgres specific variables
PGPASSWORD=postgres
POSTGRES_IMAGE=postgres:17-alpine3.22
LOCAL_PORT=5432
CONTAINER_NAME=module-dookug-postgredb
DB_LOCALE=hu_HU.UTF-8
ENCODING=UTF-8
LC_COLLATE=${DB_LOCALE}
LC_CTYPE=${DB_LOCALE}
LANG=${DB_LOCALE}
# The created database name, owner and password
DB_NAME=${PROJECT_NAME}_db
DB_OWNER=${PROJECT_NAME}_owner
DB_OWNER_PASSW=secret

# Oracle specific variables
ORACLE_IMAGE=container-registry.oracle.com/database/express:21.3.0-xe
ORACLE_PORT=1521
ORACLE_CONTAINER_NAME=module-dookug-oracle
# Oracle admin (SYS/SYSTEM/PDBADMIN) password
ORACLE_PASSWORD=developer

# Schema and service users passwords (for both DBs)
DOOKUG_PASSWORD=dooku_pwd
DOOKUG_SERVICE_PASSWORD=dooku_pwd

