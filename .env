################################################
# Version variable - modified by CI on release #
################################################
# DookuG version
VERSION=2.3.0-SNAPSHOT
# PG_TOOLS version
DBDWH_IMAGE_VERSION=1.0.0

####################
# Image variables #
####################
DOCKER_REPOSITORY=dockerhub.icellmobilsoft.hu

# Base liquibase runtime image
DOCKER_RUNTIME_LIQUIBASE=liquibase/liquibase:4.33

# DookuG
DOCKER_DOOKUG_CRESCHEMA_LIQUIBASE_NAME=${DOCKER_REPOSITORY}/liquibase/modules/dookug-creschema-liquibase
DOCKER_DOOKUG_CRESCHEMA_LIQUIBASE=${DOCKER_DOOKUG_CRESCHEMA_LIQUIBASE_NAME}:${VERSION}

DOCKER_DOOKUG_LIQUIBASE_NAME=${DOCKER_REPOSITORY}/liquibase/modules/dookug-liquibase
DOCKER_DOOKUG_LIQUIBASE=${DOCKER_DOOKUG_LIQUIBASE_NAME}:${VERSION}

