<!ENTITY propertyDateTime "
    <property name='datetime' value='timestamp(6)'       dbms='oracle' />
    <property name='datetime' value='timestamp(6)'       dbms='postgresql,edb' />
    <property name='datetime' value='timestamp(6)'       dbms='mysql' />
"
>

<!ENTITY propertyTimestamp "
    <property name='timestamp' value='timestamp'         dbms='oracle' />
    <property name='timestamp' value='timestamptz(6)'    dbms='postgresql,edb' />
    <property name='timestamp' value='timestamp'         dbms='mysql' />
"
>

<!ENTITY propertySysdate "
    <property name='sysdate' value='sysdate'            dbms='oracle' />
    <property name='sysdate' value='current_timestamp'  dbms='postgresql,edb' />
    <property name='sysdate' value='now()'              dbms='mysql' />
"
>

<!ENTITY propertyVersion "
    <property name='versionDataType' value='number'     dbms='oracle' />
    <property name='versionDataType' value='int'        dbms='postgresql,edb' />
    <property name='versionDataType' value='smallint'   dbms='mysql' />
"
>

<!ENTITY propertyLob "
    <property name='clob' value='clob'  dbms='oracle' />
    <property name='blob' value='blob'  dbms='oracle' />
    <property name='blob' value='bytea' dbms='postgresql,edb' />
    <property name='clob' value='text'  dbms='postgresql,edb' />
"
>

<!ENTITY propertyOracleCharType "
    <property name='char'   value='CHAR' dbms='oracle'/> 
    <property name='char'   value=''/> 
"
>


<!ENTITY propertiesAll "&propertySysdate; &propertyDateTime; &propertyTimestamp; &propertyVersion; &propertyLob; &propertyOracleCharType;" >
